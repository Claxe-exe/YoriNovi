{
  "name": "yorinovi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node scripts/preview.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/write-catalog.js",
    "start": "node scripts/preview.js",
    "ingest": "node scripts/check-local.js",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
